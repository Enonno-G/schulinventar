{
  "name": "@schulinventar/server",
  "version": "0.1.0",
  "private": true,
  "description": "Backend (Node.js, Express, PostgreSQL)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch src/index.js",
    "start": "node src/index.js",
    "migrate": "node --env-file-if-exists=../.env src/db/migrate.js",
    "seed": "node --env-file-if-exists=../.env src/db/seed.js",
    "test": "node --env-file-if-exists=../.env --test"
  },
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
