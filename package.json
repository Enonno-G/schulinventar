{
  "name": "schulinventar",
  "version": "0.2.0",
  "private": true,
  "description": "Schulinventar- und Belegverwaltung mit SAP-Datenaustausch (Diplomarbeit BHAK/BHAS Spittal an der Drau 2026/27)",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/start.js",
