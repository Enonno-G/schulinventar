    "testdaten": "node --env-file-if-exists=.env src/testdaten.js",
    "test": "node --env-file-if-exists=.env --test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "ejs": "^7.0.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
