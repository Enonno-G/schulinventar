# Vorlage für die Konfiguration. Kopieren nach .env und die Werte anpassen.
# Die Datei .env kommt NICHT ins Git-Repository (steht in .gitignore).

# --- Datenbank (für den Container "db" in docker-compose.yml) ---
# Passwort nur aus Buchstaben, Ziffern, - und _ (es steht auch in DATABASE_URL)
POSTGRES_DB=schulinventar
POSTGRES_USER=schulinventar
POSTGRES_PASSWORD=bitte-aendern

# --- Lokale Entwicklung (npm run dev) ---
# Verbindung vom eigenen Laptop zur Datenbank im Docker-Container
DATABASE_URL=postgres://schulinventar:bitte-aendern@localhost:5432/schulinventar
# Eigene Datenbank für "npm test" (anlegen: siehe README). Nie die Datenbank mit echten Daten verwenden.
# TEST_DATABASE_URL=postgres://schulinventar:bitte-aendern@localhost:5432/schulinventar_test

# --- Sitzungen ---
# Lange Zufallszeichenfolge (im Docker-Betrieb mindestens 32 Zeichen), erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=bitte-aendern
# Automatische Abmeldung nach so vielen Minuten ohne Aktivität
SESSION_IDLE_MINUTES=30
# Nur auf true setzen, wenn die App über HTTPS erreichbar ist (Echtbetrieb hinter einem Reverse Proxy)
COOKIE_SECURE=false
TRUST_PROXY=false

# --- Erster Administrator ---
# Wird beim Start angelegt, solange es noch keinen Benutzer gibt. Passwort mindestens 10 Zeichen.
# Nach der ersten Anmeldung in der App unter "Passwort ändern" ein eigenes Passwort setzen.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@schule.local
ADMIN_PASSWORD=bitte-aendern-1

# --- Testdaten (npm run db:seed, nur Entwicklung) ---
# Passwort der vier Testbenutzer admin@test.local, rechnungswesen@test.local,
# facility@test.local und lesen@test.local
SEED_PASSWORD=Testpasswort-2026
